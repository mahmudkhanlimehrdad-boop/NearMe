rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidImageUpload() {
      return request.resource != null
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Profile photos partitioned by visibility tier
    match /users/{uid}/photos/public/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) && isValidImageUpload();
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/photos/matches/{fileName} {
      // Only owner can upload/delete; signed-in matches access via Firestore-gated photo metadata or signed rules
      allow read: if isSignedIn();
      allow write: if isOwner(uid) && isValidImageUpload();
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/photos/private/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isValidImageUpload();
      allow delete: if isOwner(uid);
    }

    // Verification selfies (strictly owner upload + admin review)
    match /users/{uid}/verification/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isValidImageUpload();
      allow delete: if isOwner(uid);
    }

    // Chat image attachments
    match /conversations/{conversationId}/attachments/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) && isValidImageUpload();
      allow delete: if isOwner(uid);
    }
  }
}
