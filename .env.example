# ==============================================================================
# NearMe Environment Configuration
# ==============================================================================
# Never commit real secret values to version control.
# Public Firebase config is injected from firebase-applet-config.json or VITE_FIREBASE_*.

# --- Firebase Public Client Configuration (Optional override of firebase-applet-config.json) ---
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
# Standard Firestore database ID is "(default)" (already configured by default; leave empty or "(default)")
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# --- Firebase Cloud Messaging Web Push VAPID Key ---
VITE_FIREBASE_VAPID_KEY=""

# --- Payment Provider (Server-Side Only - Never prefix with VITE_) ---
# Example: Stripe secret key (sk_live_... or sk_test_...)
PAYMENT_PROVIDER_SECRET=""
# Webhook HMAC secret (Stripe whsec_... or a 64-char random hex secret for x-nearme-signature; auto-generated in local .env)
PAYMENT_WEBHOOK_SECRET=""

# --- Admin Bootstrap Secret (Server-Side Only) ---
ADMIN_BOOTSTRAP_SECRET=""

# --- App URL (Injected automatically in AI Studio Cloud Run) ---
APP_URL="http://localhost:3000"
GEMINI_API_KEY=""
